window.birseGetWishlistStorageKey=()=>{if(birseShopID==="66245492978"&&MinimogTheme?.Wishlist?.storageKey)return MinimogTheme.Wishlist.storageKey;return"birse_wishlist_ids"};window.birseGetWishlist=()=>{try{let f=localStorage.getItem(window.birseGetWishlistStorageKey());return f?JSON.parse(f):[]}catch(f){return console.error("Failed to parse wishlist data:",f),[]}};window.birseAddToWishlist=(f)=>{let g=window.birseGetWishlist();if(!g.includes(f)){if(g.push(f),localStorage.setItem(window.birseGetWishlistStorageKey(),JSON.stringify(g)),window.dispatchEvent(new CustomEvent("birseWishlistUpdate",{detail:{wishlist:g}})),birseShopID==="66245492978"&&MinimogTheme?.Wishlist)try{let j=document.querySelectorAll(`${MinimogTheme.Wishlist.selectors?.wishlistButton}[data-product-handle="${f}"]`);if(j.length>0)j.forEach((k)=>{MinimogTheme?.Wishlist?.toggleButtonState(k,!0)});else MinimogTheme?.Wishlist?.addToWishlist(f);MinimogTheme?.Wishlist?.updateWishlistCount()}catch(j){console.error(j)}}};window.birseRemoveFromWishlist=(f)=>{let g=window.birseGetWishlist(),j=g.indexOf(f);if(j>-1){if(g.splice(j,1),localStorage.setItem(window.birseGetWishlistStorageKey(),JSON.stringify(g)),window.dispatchEvent(new CustomEvent("birseWishlistUpdate",{detail:{wishlist:g}})),birseShopID==="66245492978"&&MinimogTheme?.Wishlist)try{let k=document.querySelectorAll(`${MinimogTheme.Wishlist.selectors?.wishlistButton}[data-product-handle="${f}"]`);if(k.length>0)k.forEach((q)=>{MinimogTheme?.Wishlist?.toggleButtonState(q,!1)});else MinimogTheme?.Wishlist?.removeFromWishlist(f);MinimogTheme?.Wishlist?.updateWishlistCount()}catch(k){console.error(k)}}};window.birseToggleWishlist=(f)=>{if(window.birseGetWishlist().includes(f))return window.birseRemoveFromWishlist(f),!1;else return window.birseAddToWishlist(f),!0};window.birseIsInWishlist=(f)=>{return window.birseGetWishlist().includes(f)};if(!customElements.get("birse-wishlist-button"))customElements.define("birse-wishlist-button",class extends HTMLElement{static template=null;constructor(){super();if(!this.constructor.template&&this.querySelector("template#birse-wishlist-button"))this.constructor.template=this.querySelector("template#birse-wishlist-button").content;if(this.hasAttribute("init"))this.remove()}connectedCallback(){if(this.hasAttribute("init"))return;if(this.children.length===0||this.children.length===1&&this.children[0].nodeName==="TEMPLATE"){if(this.constructor.template)this.appendChild(this.constructor.template.cloneNode(!0))}this.badge=this.querySelector(".birse-wishlist-badge"),this.updateBadge(),this.addEventListener("click",(f)=>{f.preventDefault();let g="apps/birse/wishlist";if(birseShopID==="1902182489")g="apps/wishlist/wishlist";window.location.href=(Shopify?.routes?.root??"/")+g}),this.handleStorageChangeBind=this.handleStorageChange.bind(this),window.addEventListener("storage",this.handleStorageChangeBind),this.handleWishlistUpdateBind=this.handleWishlistUpdate.bind(this),window.addEventListener("birseWishlistUpdate",this.handleWishlistUpdateBind)}disconnectedCallback(){window.removeEventListener("storage",this.handleStorageChangeBind),window.removeEventListener("birseWishlistUpdate",this.handleWishlistUpdateBind)}handleStorageChange(f){if(f.key===window.birseGetWishlistStorageKey())this.updateBadge()}handleWishlistUpdate(){this.updateBadge()}updateBadge(){if(!this.badge)return;let f=window.birseGetWishlist().length;if(f===0)this.badge.classList.add("hidden"),this.badge.textContent="";else this.badge.classList.remove("hidden"),this.badge.textContent=f>99?"99+":f.toString()}});
