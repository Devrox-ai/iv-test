      }
      #kf-geo-popup .kf-geo-icon {
        width: 38px;
        height: 38px;
        margin: 0 auto 10px;
        display: block;
        color: #555;
      }
      #kf-geo-popup .kf-geo-site {
        font-size: 13px;
        color: #888;
        margin-bottom: 4px;
        font-family: inherit;
      }
      #kf-geo-popup .kf-geo-title {
        font-size: 16px;
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: 18px;
        font-family: inherit;
        line-height: 1.35;
      }
      #kf-geo-popup .kf-geo-btn {
        display: block;
        width: 100%;
        padding: 12px 16px;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        font-family: inherit;
        letter-spacing: 0.01em;
        transition: background 0.15s, opacity 0.15s;
        margin-bottom: 10px;
      }
      #kf-geo-popup .kf-geo-btn-allow {
        background: #000;
        color: #fff;
      }
      #kf-geo-popup .kf-geo-btn-allow:hover { background: #222; }
      #kf-geo-popup .kf-geo-btn-once {
        background: #000;
        color: #fff;
      }
      #kf-geo-popup .kf-geo-btn-once:hover { background: #222; }
