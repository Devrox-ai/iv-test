<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Manage Products — Admin</title>

    <link rel="stylesheet" href="/css/theme.css">
    <script src="/js/theme.js"></script>

    <style>

        .manage-wrap{
            width: 92%;
            max-width: 1200px;
            margin: 50px auto 100px;
        }

        .manage-head{
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 30px;
        }

        .manage-back{
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            letter-spacing: 1px;
            text-transform: uppercase;
            text-decoration: none;
            color: var(--wine);
        }

        .manage-head h1{
            font-size: 34px;
            color: var(--wine-deep);
            font-weight: 500;
        }

        .manage-actions{ display: flex; gap: 10px; }

        .manage-actions a{
            font-size: 12px;
            letter-spacing: 1px;
            text-transform: uppercase;
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 30px;
            border: 1px solid var(--wine);
            color: var(--wine);
        }

        .manage-actions a.solid{ background: var(--wine); color: white; }

        .admin-alert{
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 13px;
            margin-bottom: 20px;
            background: #e7f6ec;
            color: #206b3a;
            border: 1px solid #b9e4c6;
        }

        .manage-grid{
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 20px;
        }

        .manage-card{
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 6px 18px rgba(60,20,40,0.08);
        }

        .manage-card .m-img{
            width: 100%;
            height: 200px;
            position: relative;
            overflow: hidden;
        }

        .manage-card .m-img img{ width: 100%; height: 100%; object-fit: cover; }

        .manage-card .m-body{ padding: 14px 16px 18px; }

        .manage-card h4{ font-size: 16px; color: var(--ink); margin-bottom: 4px; }

        .manage-card .m-cat{
            font-size: 11px;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 6px;
        }

        .manage-card .m-price{
            font-size: 15px;
            font-weight: 600;
            color: var(--wine-deep);
            margin-bottom: 12px;
        }

        .manage-card form{ margin: 0; }

        .edit-btn{
            flex: 1;
            display: inline-block;
            text-align: center;
            padding: 10px 14px;
            font-size: 12px;
            letter-spacing: 1px;
            text-transform: uppercase;
            text-decoration: none;
            border-radius: 30px;
            border: 1px solid var(--wine);
            color: var(--wine);
            background: white;
        }

        .edit-btn:hover{ background: var(--wine); color: white; }

        .empty-state{ text-align: center; padding: 70px 20px; color: #8a7a86; font-size: 16px; }

    </style>

</head>

<body>

    <div class="manage-wrap">

        <a href="/admin/dashboard" class="manage-back">← Admin Dashboard</a>

        <div class="manage-head" style="margin-top: 18px;">
            <h1>Manage Products</h1>
            <div class="manage-actions">
                <a href="/product/manage-categories">Manage Categories</a>
                <a href="/product/manage-orders">Orders</a>
                <form action="/admin/initialize-sizes" method="POST" style="display:inline;" onsubmit="return confirm('Add size inventory to products that do not have sizes yet?');"><button type="submit" class="edit-btn" style="border:0;cursor:pointer;">Initialize Sizes</button></form>
                <a href="/product/product-form" class="solid">+ Add Product</a>
            </div>
        </div>

        <% if(typeof deleted !== 'undefined' && deleted){ %>
            <div class="admin-alert">Product deleted successfully.</div>
        <% } %>

        <% if(typeof updated !== 'undefined' && updated){ %>
            <div class="admin-alert">Product updated successfully.</div>
        <% } %>

        <% if(products.length > 0){ %>

            <div class="manage-grid">

                <% products.forEach(function(product){ %>

                    <div class="manage-card">

                        <div class="m-img">
                            <img src="/images/<%= product.image %>" alt="<%= product.title %>"
                                onerror="imgFallback(this, '<%= product.title.replace(/'/g, '') %>')">
                        </div>

                        <div class="m-body">
                            <h4><%= product.title %></h4>
                            <div class="m-cat"><%= categoryMap[product.categoryId] || 'Uncategorized' %></div>
                            <div class="m-price"><%= product.price ? '₹' + product.price.toLocaleString('en-IN') : 'No price set' %></div>
                            <% if(Array.isArray(product.sizes) && product.sizes.length){ %>
                                <div class="size-summary">
                                <% product.sizes.forEach(function(size){ 
                                    var q = product.sizeStock && product.sizeStock[size] != null ? Number(product.sizeStock[size]) : 0;
                                %><span class="size-pill"><%= size %>: <%= q %></span><% }) %>
                                </div>
                            <% } %>

                            <div style="font-size:11px;margin:-4px 0 10px;color:<%= Number(product.stock||0)<=0?'#a33b3b':(Number(product.stock||0)<=Number(product.lowStockLimit||5)?'#b56b17':'#21734a') %>;font-weight:700;">
                                Stock: <%= product.stock ?? 0 %>
                                <%= Number(product.stock||0)<=0 ? ' — OUT OF STOCK' : (Number(product.stock||0)<=Number(product.lowStockLimit||5) ? ' — LOW STOCK' : ' — IN STOCK') %>
                            </div>

                            <div style="display:flex; gap:8px;">

                                <a href="/product/edit/<%= product._id %>" class="edit-btn">Edit</a>

                                <form action="/product/delete/<%= product._id %>" method="POST"
                                    onsubmit="return confirm('Delete this product?');" style="flex:1;">
                                    <button type="submit" class="remove-btn">Delete</button>
                                </form>

                            </div>
                        </div>

                    </div>

                <% }) %>

            </div>

        <% } else { %>

            <div class="empty-state">No products yet.</div>

        <% } %>

    </div>

    <script src="/js/theme.js"></script>

</body>

</html>
