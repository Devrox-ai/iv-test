<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Product — Admin</title>

    <link rel="stylesheet" href="/css/theme.css">

    <style>

        .admin-wrap{
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 16px;
            background: linear-gradient(160deg, var(--ivory) 0%, #f3e6d8 100%);
        }

        .admin-card{
            width: 100%;
            max-width: 480px;
            background: white;
            border-radius: 14px;
            padding: 40px 34px;
            box-shadow: 0 20px 60px rgba(60,20,40,0.12);
            border-top: 4px solid var(--gold);
        }

        .admin-back{
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            letter-spacing: 1px;
            text-transform: uppercase;
            text-decoration: none;
            color: var(--wine);
            margin-bottom: 22px;
        }

        .admin-eyebrow{
            font-size: 12px;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: var(--gold);
        }

        .admin-card h1{
            font-size: 34px;
            color: var(--wine-deep);
            margin-top: 6px;
            margin-bottom: 26px;
            font-weight: 500;
        }

        .admin-alert{
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 13px;
            margin-bottom: 20px;
        }

        .admin-alert.error{ background: #fbe9e9; color: #a33; border: 1px solid #f3c4c4; }

        .field{ margin-bottom: 20px; }

        .field label{
            display: block;
            font-size: 12px;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #6b5a65;
            margin-bottom: 8px;
        }

        .field input[type="text"],
        .field input[type="number"],
        .field select{
            width: 100%;
            padding: 13px 14px;
            border: 1px solid var(--line);
            border-radius: 8px;
            font-size: 15px;
            font-family: "Jost", sans-serif;
            background: var(--ivory);
            outline: none;
            transition: 0.2s;
        }

        .field input:focus,
        .field select:focus{ border-color: var(--gold); background: white; }

        .current-img{
            width: 100%;
            max-height: 220px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid var(--line);
            margin-bottom: 12px;
        }

        .upload-box{
            border: 2px dashed var(--line);
            border-radius: 10px;
            padding: 22px;
            text-align: center;
            cursor: pointer;
            position: relative;
            transition: 0.2s;
            background: var(--ivory);
        }

        .upload-box:hover{ border-color: var(--gold); background: #fbf2e2; }

        .upload-box input[type="file"]{
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
        }

        .upload-box .u-icon{ font-size: 26px; margin-bottom: 8px; }
        .upload-box .u-text{ font-size: 13px; color: #6b5a65; }
        .upload-box .u-text span{ color: var(--wine); font-weight: 500; }

        .submit-btn{
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 30px;
            background: var(--wine);
            color: white;
            font-size: 13px;
            letter-spacing: 2px;
            text-transform: uppercase;
            cursor: pointer;
            transition: 0.25s;
            font-family: "Jost", sans-serif;
        }

        .submit-btn:hover{ background: var(--wine-deep); }

    </style>

</head>

<body>

    <div class="admin-wrap">

        <div class="admin-card">

            <a href="/product/manage" class="admin-back">← Back To Manage Products</a>

            <span class="admin-eyebrow">Admin Panel</span>
            <h1>Edit Product</h1>

            <% if(typeof error !== 'undefined' && error){ %>
                <div class="admin-alert error"><%= error %></div>
            <% } %>

            <form
                action="/product/update/<%= product._id %>"
                method="POST"
                enctype="multipart/form-data"
            >

                <!-- PRODUCT NAME -->

                <div class="field">
                    <label>Product Name</label>
                    <input
                        type="text"
                        name="title"
                        value="<%= product.title %>"
                        required
                    >
                </div>

                <!-- PRICE -->

                <div class="field">
                    <label>Price (₹)</label>
                    <input
                        type="number"
                        name="price"
                        value="<%= product.price || '' %>"
                        min="0"
                        step="1"
                        required
                    >
                </div>

                <!-- INVENTORY -->
                <div class="field">
                    <label>Stock Quantity</label>
                    <input type="number" name="stock" min="0" step="1" value="<%= product.stock ?? 0 %>" required>
                </div>

                <div class="field">
                    <label>Low Stock Alert At</label>
                    <input type="number" name="lowStockLimit" min="0" step="1" value="<%= product.lowStockLimit ?? 5 %>" required>
                </div>

                <!-- CATEGORY -->

                <div class="field">
                    <label>Category</label>
                    <select name="categoryId" required>

                        <option value="">Select Category</option>

                        <% categories.forEach(category => { %>
                            <option value="<%= category._id %>" <%= product.categoryId == category._id.toString() ? 'selected' : '' %>><%= category.name %></option>
                        <% }) %>

                    </select>
                </div>

                <!-- SIZE INVENTORY -->
                <div class="field">
                    <label>Available Sizes & Size-wise Stock</label>
                    <div class="size-admin-grid">
                    <% availableSizes.forEach(function(size){ 
                        var enabled = Array.isArray(product.sizes) && product.sizes.includes(size);
                        var qty = product.sizeStock && product.sizeStock[size] != null ? product.sizeStock[size] : 0;
                    %>
                        <div class="size-admin-item">
                            <label>
                                <span><input type="checkbox" name="sizes" value="<%= size %>" <%= enabled ? 'checked' : '' %> onchange="toggleSizeStock(this)"> <%= size %></span>
                                <span>Stock</span>
                            </label>
                            <input type="number" name="sizeStock_<%= size %>" min="0" step="1" value="<%= qty %>" <%= enabled ? '' : 'disabled' %>>
                        </div>
                    <% }) %>
                    </div>
                    <div style="font-size:10px;color:#8a7b82;margin-top:8px;">Example: M = 4, L = 6, XL = 0 means XL is sold out.</div>
                </div>

                <!-- CURRENT IMAGE + REPLACE -->

                <div class="field">
                    <label>Product Image</label>

                    <img class="current-img" src="/images/<%= product.image %>" alt="<%= product.title %>">

                    <div class="upload-box">
                        <input type="file" name="image" accept="image/*">
                        <div class="u-icon">📷</div>
                        <div class="u-text"><span>Click to replace</span> (leave empty to keep current image)</div>
                    </div>

                </div>

                <button type="submit" class="submit-btn">Save Changes</button>

            </form>

        </div>

    </div>

<script>
function toggleSizeStock(box){
    const input = box.closest(".size-admin-item").querySelector('input[type="number"]');
    if(input){ input.disabled = !box.checked; }
}
</script>

</body>

</html>
