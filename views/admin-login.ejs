<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Vastraa Admin Login</title><style>*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;background:#f7efe9;font-family:Arial;color:#3b1726;padding:18px}.box{width:min(410px,100%);background:#fff;padding:30px;border:1px solid #eadbd4;border-radius:22px;box-shadow:0 20px 60px #3b17261a}.logo{text-align:center;font:30px Georgia;color:#681b3a;letter-spacing:4px}.sub{text-align:center;color:#8a737d;font-size:11px;margin:6px 0 24px}h1{font:23px Georgia;margin:0 0 8px}.hint{font-size:12px;color:#806f77;line-height:1.5;margin-bottom:18px}.err{background:#fff0f0;color:#9c2636;border:1px solid #f1cccc;padding:10px;border-radius:9px;font-size:12px;margin-bottom:13px}label{font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;display:block;margin:12px 0 6px}input{width:100%;height:45px;border:1px solid #e2d4ce;border-radius:10px;padding:0 12px;font-size:14px}button{width:100%;height:45px;margin-top:17px;border:0;border-radius:10px;background:#681b3a;color:white;font-weight:700;cursor:pointer}.back{text-align:center;margin-top:16px;font-size:11px}.back a{color:#681b3a;text-decoration:none}</style></head><body><div class="box"><div class="logo">VASTRAA</div><div class="sub">ADMIN CONTROL CENTER</div><% if(error){ %><div class="err"><%= error %></div><% } %><h1>Admin Login</h1><p class="hint">Use your admin username and password. Once logged in, the admin session is remembered in this browser for up to 30 days of activity.</p><form action="/admin/login" method="POST"><label>Username</label><input name="username" autocomplete="username" required><label>Password</label><input name="password" type="password" autocomplete="current-password" required><button>Login to Dashboard</button></form><div class="back"><a href="/product/home">← Back to store</a></div></div></body></html>
