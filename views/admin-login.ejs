<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Admin Login — Vastraa</title>
<style>
*{box-sizing:border-box;font-family:Poppins,Arial,sans-serif}body{min-height:100vh;display:grid;place-items:center;background:#140b10;padding:20px}.box{width:min(400px,100%);background:#fff;border-radius:20px;padding:32px;box-shadow:0 25px 70px #0008}.brand{font-size:25px;letter-spacing:4px;color:#641c3d;text-align:center;font-weight:700}.sub{text-align:center;color:#777;margin:7px 0 25px;font-size:13px}label{display:block;font-size:12px;margin:13px 0 6px}input{width:100%;padding:13px;border:1px solid #ddd;border-radius:10px}button{width:100%;margin-top:20px;padding:13px;border:0;border-radius:10px;background:#641c3d;color:#fff;font-weight:600}.error{background:#fee;color:#9b1c31;padding:10px;border-radius:8px;font-size:12px}
</style></head><body><div class="box"><div class="brand">VASTRAA</div><div class="sub">Admin control panel</div><% if(error){ %><div class="error"><%= error %></div><% } %><form method="POST" action="/admin/login"><label>Username</label><input name="username" required><label>Password</label><input name="password" type="password" required><button>Open Admin Panel</button></form></div></body></html>
