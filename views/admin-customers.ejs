<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title><%= shopName %> — Customers</title>
<style>
:root{--wine:#5b1635;--cream:#fbf8f5;--line:#eadfd8;--text:#30252b;--muted:#887982;--shadow:0 10px 35px rgba(57,24,39,.08)}
*{box-sizing:border-box}body{margin:0;background:var(--cream);color:var(--text);font-family:Inter,Arial,sans-serif}.top{background:#fff;border-bottom:1px solid var(--line);padding:14px 4%;display:flex;justify-content:space-between;align-items:center;gap:15px;position:sticky;top:0;z-index:5}.brand{font-family:Georgia,serif;color:#351020;font-size:21px}.nav{display:flex;gap:8px;flex-wrap:wrap}.nav a{padding:9px 12px;border-radius:8px;text-decoration:none;color:#5b4a53;font-size:12px}.nav a.active,.nav a:hover{background:#f4e9ee;color:var(--wine)}.wrap{width:min(1250px,94%);margin:28px auto 60px}.head{display:flex;justify-content:space-between;gap:15px;align-items:end;margin-bottom:20px}.head h1{font:500 31px Georgia,serif;color:#351020;margin:0}.head p{font-size:12px;color:var(--muted);margin:7px 0 0}.search{width:300px;max-width:100%;padding:12px;border:1px solid #ded3cd;border-radius:9px;outline:none;background:#fff}.table{background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden;box-shadow:var(--shadow)}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:14px 16px;border-bottom:1px solid #eee6e1;font-size:12px}th{background:#fcfaf9;color:#796a72;text-transform:uppercase;letter-spacing:.7px;font-size:10px}tr:last-child td{border-bottom:0}.customer{font-weight:700;color:#351020}.sub{display:block;color:var(--muted);font-size:10px;margin-top:4px}.money{font-weight:800;color:var(--wine)}.empty{text-align:center;padding:60px;color:var(--muted)}
@media(max-width:700px){.top{align-items:flex-start;flex-direction:column}.head{align-items:stretch;flex-direction:column}table,thead,tbody,tr,td{display:block}thead{display:none}.table{background:transparent;border:0;box-shadow:none}tr{background:#fff;border:1px solid var(--line);border-radius:12px;margin-bottom:12px;overflow:hidden}td{display:flex;justify-content:space-between;gap:15px;padding:12px 14px}td:before{content:attr(data-label);font-size:9px;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);font-weight:700}.search{width:100%}}
</style>
</head>
<body>
<header class="top">
  <div class="brand"><%= shopName %> · Admin</div>
  <nav class="nav">
    <a href="/admin/dashboard">Dashboard</a><a href="/product/product-form">+ Product</a><a href="/product/manage">Products</a><a href="/product/manage-categories">Categories</a><a class="active" href="/admin/customers">Customers</a><a href="/admin/logout">Logout</a>
  </nav>
</header>
<main class="wrap">
  <div class="head"><div><h1>Customers</h1><p>Customer accounts and their order history at a glance.</p></div><input id="search" class="search" placeholder="Search name, email or phone..."></div>
  <div class="table">
  <% if(users.length){ %>
  <table><thead><tr><th>Customer</th><th>Phone</th><th>Orders</th><th>Total spent</th><th>Last order</th></tr></thead>
  <tbody>
  <% users.forEach(function(u){ const st=stats[u._id.toString()]||{count:0,total:0,last:null}; %>
    <tr class="row" data-search="<%= ((u.name||'')+' '+(u.email||'')+' '+(u.phone||'')).toLowerCase() %>" style="cursor:pointer" onclick="location.href='/admin/customers/<%= u._id %>'">
      <td data-label="Customer"><span class="customer"><%= u.name||'Customer' %></span><span class="sub"><%= u.email||'No email' %></span></td>
      <td data-label="Phone"><%= u.phone||'—' %></td>
      <td data-label="Orders"><%= st.count %></td>
      <td data-label="Total spent"><span class="money">₹<%= Number(st.total||0).toLocaleString('en-IN') %></span></td>
      <td data-label="Last order"><%= st.last ? new Date(st.last).toLocaleString('en-IN') : '—' %></td>
    </tr>
  <% }) %>
  </tbody></table>
  <% } else { %><div class="empty">No customers yet.</div><% } %>
  </div>
</main>
<script>
const q=document.getElementById('search');q.addEventListener('input',()=>{const v=q.value.toLowerCase().trim();document.querySelectorAll('.row').forEach(r=>r.style.display=!v||r.dataset.search.includes(v)?'block':'none')});
</script>
</body>
</html>