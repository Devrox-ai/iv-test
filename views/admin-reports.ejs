<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Reports — <%= shopName %></title>
<style>
:root{--wine:#5b1635;--deep:#351020;--cream:#faf7f4;--line:#e8ddd6;--muted:#887982}
*{box-sizing:border-box}body{margin:0;background:var(--cream);color:#30252b;font:13px Arial}.top{background:#fff;border-bottom:1px solid var(--line);padding:14px 4%;display:flex;justify-content:space-between}.top a{color:var(--wine);text-decoration:none;font-size:11px}.wrap{width:min(1200px,94%);margin:25px auto 60px}.head h1{font:500 29px Georgia;color:var(--deep);margin:0}.head p{color:var(--muted);font-size:11px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:18px 0}.stat{background:#fff;border:1px solid var(--line);border-radius:12px;padding:16px}.stat small{color:var(--muted);font-size:9px}.stat b{display:block;font-size:21px;color:var(--deep);margin-top:7px}.grid{display:grid;grid-template-columns:1.2fr 1fr;gap:14px}.card{background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden}.card h2{margin:0;padding:14px 16px;border-bottom:1px solid #eee6e1;font-size:13px;color:var(--deep)}.body{padding:15px}.bar{display:flex;align-items:center;gap:8px;margin:10px 0}.bar label{width:115px;font-size:10px}.track{flex:1;background:#f1e8e4;border-radius:20px;height:10px;overflow:hidden}.fill{height:100%;background:#8b4d69}.bar strong{width:55px;text-align:right;font-size:10px}.product{display:flex;gap:10px;padding:9px 0;border-bottom:1px solid #eee6e1;align-items:center}.product:last-child{border:0}.img{width:45px;height:55px;object-fit:cover;border-radius:6px;background:#f3ebe6}.product div{flex:1}.product b{display:block;font-size:10px}.product small{display:block;color:var(--muted);font-size:9px;margin-top:4px}.money{color:var(--wine);font-weight:800;font-size:11px}@media(max-width:750px){.grid{grid-template-columns:1fr}.stats{grid-template-columns:1fr}}
</style></head><body><header class="top"><a href="/admin/dashboard">← Dashboard</a><a href="/admin/logout">Logout</a></header><main class="wrap"><div class="head"><h1>Sales & Operations Reports</h1><p>Quick view of sales, order volume, payments and best sellers.</p></div>
<section class="stats"><div class="stat"><small>Today Sales</small><b>₹<%= Number(todaySales).toLocaleString('en-IN') %></b></div><div class="stat"><small>Last 7 Days Sales</small><b>₹<%= Number(weekSales).toLocaleString('en-IN') %></b></div><div class="stat"><small>This Month Sales</small><b>₹<%= Number(monthSales).toLocaleString('en-IN') %></b></div><div class="stat"><small>Today Orders</small><b><%= todayOrders %></b></div><div class="stat"><small>7 Day Orders</small><b><%= weekOrders %></b></div><div class="stat"><small>Month Orders</small><b><%= monthOrders %></b></div></section>
<div class="grid">
<section class="card"><h2>💳 Payment Methods</h2><div class="body">
<% const pTotal=orders.length||1; Object.entries(paymentStats).forEach(function(pair){ %><div class="bar"><label><%= pair[0] %></label><div class="track"><div class="fill" style="width:<%= Math.min(100,(pair[1]/pTotal)*100) %>%"></div></div><strong><%= pair[1] %></strong></div><% }) %>
</div></section>
<section class="card"><h2>🏆 Best Sellers</h2><div class="body">
<% bestSellers.slice(0,10).forEach(function(p){ %><div class="product"><% if(p.image){ %><img class="img" src="/images/<%= p.image %>"><% } else { %><div class="img"></div><% } %><div><b><%= p.title %></b><small><%= p.qty %> sold</small></div><span class="money">₹<%= Number(p.sales||0).toLocaleString('en-IN') %></span></div><% }) %>
<% if(!bestSellers.length){ %><p style="color:#887982;font-size:11px">No sales yet.</p><% } %>
</div></section>
</div></main></body></html>