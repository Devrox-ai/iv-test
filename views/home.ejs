<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vastraa — Threads Woven With Tradition</title>

<link rel="stylesheet" href="/css/theme.css">
<script src="/js/theme.js"></script>

<style>
    /* --- HERO STYLES --- */
    .hero{
        width: 92%;
        max-width: 1400px;
        margin: 60px auto;
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 40px;
        align-items: center;
    }

    .hero-copy .eyebrow{
        display: inline-block;
        font-size: 12px;
        letter-spacing: 4px;
        text-transform: uppercase;
        color: #C7962F;
        border-bottom: 1px solid #C7962F;
        padding-bottom: 6px;
        margin-bottom: 22px;
    }

    .hero-copy h1{
        font-size: 68px;
        line-height: 1.05;
        font-weight: 500;
        color: #3E0F22;
    }

    .hero-copy h1 em{ font-style: italic; color: #5C1A33; }

    .hero-copy p{
        margin-top: 22px;
        font-size: 16px;
        line-height: 1.7;
        color: #5a4c56;
        max-width: 480px;
    }

    .hero-btn{
        display: inline-block;
        margin-top: 32px;
        background: #5C1A33;
        color: white;
        text-decoration: none;
        padding: 15px 34px;
        font-size: 13px;
        letter-spacing: 2px;
        text-transform: uppercase;
        border-radius: 2px;
        transition: 0.3s;
    }

    .hero-btn:hover{ background: #3E0F22; transform: translateY(-2px); }

    .hero-motif{
        position: relative;
        aspect-ratio: 1/1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hero-motif svg{ width: 100%; height: 100%; }

    /* --- 3D SPOTLIGHT CAROUSEL --- */
    .carousel-section {
        margin: 60px 0;
        text-align: center;
        overflow: hidden;
    }

    .carousel-container {
        position: relative;
        width: 100%;
        max-width: 1000px;
        height: 480px;
        margin: 40px auto 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .carousel-track {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .c-card {
        position: absolute;
        width: 260px;
        height: 420px;
        border-radius: 12px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
        cursor: pointer;
        user-select: none;
    }

    .c-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .c-card .c-info {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(transparent, rgba(0,0,0,0.85));
        padding: 20px 15px 15px;
        color: #fff;
        text-align: center;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .c-card.active .c-info {
        opacity: 1;
    }

    .c-info h4 {
        font-size: 13px;
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 10px;
    }

    .c-info .v-btn {
        display: inline-block;
        background: #000;
        color: #fff;
        padding: 6px 20px;
        font-size: 11px;
        text-transform: uppercase;
        text-decoration: none;
        border-radius: 2px;
        letter-spacing: 1px;
    }

    .c-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 42px;
        height: 42px;
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid #ddd;
        border-radius: 50%;
        cursor: pointer;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        color: #333;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        transition: 0.3s;
    }

    .c-nav:hover { background: #000; color: #fff; }
    .c-nav.prev { left: 10px; }
    .c-nav.next { right: 10px; }

    /* --- HORIZONTAL SLIDER --- */
    .slider-wrapper {
        position: relative;
        width: 100%;
        padding: 0 40px;
        box-sizing: border-box;
    }

    .slider-container {
        display: flex;
        gap: 20px;
        overflow-x: auto;
        scroll-behavior: smooth;
        scrollbar-width: none;
        padding: 10px 0;
        scroll-snap-type: x mandatory;
    }

    .slider-container::-webkit-scrollbar { display: none; }

    .slider-container .p-card,
    .slider-container .cat-card {
        flex: 0 0 calc(25% - 15px);
        min-width: 240px;
        scroll-snap-align: start;
    }

    .slider-btn {
        position: absolute;
        top: 45%;
        transform: translateY(-50%);
        width: 44px;
        height: 44px;
        background: #ffffff;
        border: 1px solid #e0e0e0;
        border-radius: 4px;
        cursor: pointer;
        z-index: 5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        color: #111;
        box-shadow: 0 2px 8px rgba(0,0,0,0.12);
        transition: all 0.2s ease;
    }

    .slider-btn:hover { background: #000000; color: #ffffff; border-color: #000000; }
    .slider-btn.left { left: 0px; }
    .slider-btn.right { right: 0px; }

    @media(max-width: 768px){
        .hero{ grid-template-columns: 1fr; }
        .slider-container .p-card, .slider-container .cat-card { flex: 0 0 calc(50% - 10px); }
        .slider-wrapper { padding: 0 20px; }
    }
</style>

</head>

<body>

    <%- include('partials/navbar') %>

    <!-- HERO -->

    <div class="hero">

        <div class="hero-copy">

            <span class="eyebrow">Festive Edit 2026</span>

            <h1>Threads Woven<br>With <em>Tradition</em></h1>

            <p>
                Discover handpicked kurtas, sarees and bridal wear crafted by
                master artisans — where timeless Indian craft meets modern silhouettes.
            </p>

            <a href="#trending" class="hero-btn">Explore The Collection</a>

        </div>

        <div class="hero-motif">

            <svg viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="200" cy="200" r="188" stroke="#C7962F" stroke-width="1.5"/>
                <circle cx="200" cy="200" r="150" stroke="#5C1A33" stroke-width="1"/>
                <path d="M200 90c-45 0-80 40-80 85 0 55 45 70 45 110 0 22 16 35 35 35s35-13 35-35c0-40 45-55 45-110 0-45-35-85-80-85z"
                    fill="none" stroke="#5C1A33" stroke-width="2.5"/>
                <path d="M200 130c-25 0-45 22-45 48 0 32 25 40 25 63 0 12 9 20 20 20s20-8 20-20c0-23 25-31 25-63 0-26-20-48-45-48z"
                    fill="#C7962F" opacity="0.85"/>
                <circle cx="200" cy="150" r="10" fill="#3E0F22"/>
                <g opacity="0.55">
                    <path d="M80 200a120 120 0 0 1 240 0" stroke="#C7962F" stroke-width="1" stroke-dasharray="2 8"/>
                </g>
            </svg>

        </div>

    </div>

    <!-- 3D TRENDING STYLES CAROUSEL -->

    <div class="carousel-section">

        <div class="section-head">
            <span class="eyebrow">Spotlight</span>
            <h2>Trending Styles</h2>
            <div class="rule"></div>
        </div>

        <% if(displayProducts && displayProducts.length > 0){ %>

            <div class="carousel-container">
                <button class="c-nav prev" id="cPrev">&#10094;</button>

                <div class="carousel-track" id="cTrack">
                    <% displayProducts.forEach(function(product, i){ %>
                        <div class="c-card" data-index="<%= i %>">
                            <img src="/images/<%= product.image %>" alt="<%= product.title %>" onerror="imgFallback(this, '<%= product.title.replace(/'/g, '') %>')">
                            <div class="c-info">
                                <h4><%= product.title %></h4>
                                <a href="/product/view/<%= product._id %>" class="v-btn">View</a>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <button class="c-nav next" id="cNext">&#10095;</button>
            </div>

        <% } %>

    </div>

    <!-- TRENDING PRODUCTS (HORIZONTAL SLIDER WITH 4 CARDS AT A TIME) -->

    <div class="section" id="trending">

        <div class="section-head">
            <span class="eyebrow"><%= filterCategoryName ? 'Curated Collection' : 'Curated For You' %></span>
            <h2><%= filterCategoryName ? filterCategoryName : 'Best Sellers' %></h2>
            <div class="rule"></div>
            <% if(filterCategoryName){ %>
                <a href="/product/home" style="display:inline-block; margin-top:14px; font-size:12px; letter-spacing:1px; text-transform:uppercase; color: var(--wine); text-decoration:none; border-bottom:1px solid var(--wine);">✕ Clear Filter — View All</a>
            <% } %>
        </div>

        <% if(displayProducts.length > 0){ %>

            <div class="slider-wrapper">
                <% if(displayProducts.length > 4){ %>
                    <button class="slider-btn left" onclick="slideScroll('prod-slider', -300)">&#10094;</button>
                    <button class="slider-btn right" onclick="slideScroll('prod-slider', 300)">&#10095;</button>
                <% } %>

                <div class="slider-container" id="prod-slider">

                    <% displayProducts.forEach(function(product, i){ %>

                        <div class="p-card">

                            <% if(!filterCategoryName && i < 3){ %>
                                <span class="tag">Best Seller</span>
                            <% } %>

                            <a href="/product/view/<%= product._id %>" class="p-img">
                                <img src="/images/<%= product.image %>" alt="<%= product.title %>"
                                    onerror="imgFallback(this, '<%= product.title.replace(/'/g, '') %>')">
                            </a>

                            <div class="p-body">

                                <a href="/product/view/<%= product._id %>" style="text-decoration:none; color:inherit;">
                                    <h4><%= product.title %></h4>
                                </a>
                                <div class="p-meta">Premium Handcrafted</div>
                                <% if(product.price){ %>
                                    <div class="p-price">₹<%= product.price.toLocaleString('en-IN') %></div>
                                <% } %>

                                <a href="/product/view/<%= product._id %>" class="cart-btn" style="display:block;text-align:center;text-decoration:none;">Select Size</a>

                            </div>

                        </div>

                    <% }) %>

                </div>
            </div>

        <% } else { %>

            <div class="empty-state">
                <div class="e-icon">🧵</div>
                <%= filterCategoryName ? 'No products found in this category yet.' : 'No products added yet — visit the admin panel to add your first product.' %>
            </div>

        <% } %>

    </div>

    <!-- SHOP WITH A STYLIST BANNER -->

    <div class="stylist-banner" style="position: relative; width: 100%; min-height: 380px; display: flex; align-items: center; justify-content: center; text-align: center; color: #ffffff; margin: 60px 0; padding: 40px 20px; background: linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.45)), url('/images/Buy%20Ethnic%20Summer%20Dresses%20for%20Men%20%26%20Women%20Online_%20KALKI%20Fashion%20India_files/Rock_Your_Wedding_In_These__Made_For_Each_Other_Bride_And_Groom.webp') center/cover no-repeat;">
        <div class="stylist-content">
            <h3 style="font-size: 28px; font-weight: 400; letter-spacing: 1px; margin-bottom: 12px; font-family: serif;">Shop With A Stylist</h3>
            <h2 style="font-size: 34px; font-weight: 600; letter-spacing: 0.5px; margin-bottom: 14px; font-family: serif;">Expert Advice, Just A Video Call Away.</h2>
            <p style="font-size: 14px; letter-spacing: 0.5px; margin-bottom: 28px; opacity: 0.9;">Our Stylists speak English, Hindi, Gujarati & Marathi</p>
            <a href="https://wa.me/917862083025" target="_blank" class="stylist-btn" style="display: inline-block; background: #ffffff; color: #111111; padding: 12px 32px; font-size: 12px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; text-decoration: none; border-radius: 2px; transition: 0.3s ease;">Start Call Now</a>
        </div>
    </div>

    <!-- CATEGORY SHOWCASE (HORIZONTAL SLIDER WITH 4 CARDS AT A TIME) -->

    <div class="section">

        <div class="section-head">
            <span class="eyebrow">Shop By Category</span>
            <h2>Explore Collections</h2>
            <div class="rule"></div>
        </div>

        <% if(categories.length > 0){ %>

            <div class="slider-wrapper">
                <% if(categories.length > 4){ %>
                    <button class="slider-btn left" onclick="slideScroll('cat-slider', -300)">&#10094;</button>
                    <button class="slider-btn right" onclick="slideScroll('cat-slider', 300)">&#10095;</button>
                <% } %>

                <div class="slider-container" id="cat-slider">

                    <% categories.forEach(function(category){ %>

                        <a href="/product/category/<%= category._id %>" class="cat-card">

                            <div class="cat-img">
                                <img src="/images/<%= category.image %>" alt="<%= category.name %>"
                                    onerror="imgFallback(this, '<%= category.name.replace(/'/g, '') %>')">
                            </div>

                            <h3><%= category.name %></h3>

                        </a>

                    <% }) %>

                </div>
            </div>

        <% } else { %>

            <div class="empty-state">
                <div class="e-icon">📁</div>
                No categories added yet.
            </div>

        <% } %>

    </div>

    <!-- BEHIND THE WEAVE (BTS / CRAFT PROCESS) -->

    <div class="craft-section">

        <div class="craft-inner">

            <div class="section-head">
                <span class="eyebrow">Behind The Weave</span>
                <h2>From Loom To Your Wardrobe</h2>
                <div class="rule"></div>
            </div>

            <div class="craft-steps">

                <div class="craft-step">
                    <div class="num">01</div>
                    <h4>Handpicked Fabric</h4>
                    <p>Every yard of silk, cotton and georgette is sourced directly from trusted regional weavers.</p>
                </div>

                <div class="craft-step">
                    <div class="num">02</div>
                    <h4>Artisan Embroidery</h4>
                    <p>Skilled karigars hand-embellish each piece with zari, resham and mirror work.</p>
                </div>

                <div class="craft-step">
                    <div class="num">03</div>
                    <h4>Quality Check</h4>
                    <p>Every garment passes a strict finish and stitching inspection before it's packed.</p>
                </div>

                <div class="craft-step">
                    <div class="num">04</div>
                    <h4>Delivered To You</h4>
                    <p>Carefully wrapped and shipped across India with real-time order tracking.</p>
                </div>

            </div>

        </div>

    </div>

    <!-- TRUST STRIP -->

    <div class="trust-strip">

        <div class="trust-item">
            <span class="t-icon">🚚</span>
            <div>
                <h5>Free Shipping</h5>
                <p>On all prepaid orders above ₹2999</p>
            </div>
        </div>

        <div class="trust-item">
            <span class="t-icon">↩️</span>
            <div>
                <h5>Easy Returns</h5>
                <p>7-day hassle free return policy</p>
            </div>
        </div>

        <div class="trust-item">
            <span class="t-icon">🔒</span>
            <div>
                <h5>Secure Payments</h5>
                <p>100% safe & encrypted checkout</p>
            </div>
        </div>

        <div class="trust-item">
            <span class="t-icon">🧵</span>
            <div>
                <h5>Certified Artisans</h5>
                <p>Supporting genuine handloom craft</p>
            </div>
        </div>

    </div>

    <%- include('partials/footer') %>

    <%- include('partials/whatsapp-widget') %>

    <%- include('partials/login-toast') %>

    <!-- SCRIPTS -->
    <script>
        // Mega Menu Tabs Switcher
        function switchTab(event, panelId) {
            const sidebar = event.currentTarget.parentElement;
            const rightContent = sidebar.nextElementSibling;

            sidebar.querySelectorAll('.sidebar-tab').forEach(tab => tab.classList.remove('active'));
            event.currentTarget.classList.add('active');

            rightContent.querySelectorAll('.tab-panel').forEach(panel => panel.classList.remove('active'));
            const targetPanel = rightContent.querySelector('#' + panelId);
            if(targetPanel) {
                targetPanel.classList.add('active');
            }
        }

        // Horizontal Scroll Function
        function slideScroll(elementId, distance) {
            const container = document.getElementById(elementId);
            if (container) {
                container.scrollBy({
                    left: distance,
                    behavior: 'smooth'
                });
            }
        }

        // 3D Spotlight Carousel Script
        document.addEventListener('DOMContentLoaded', () => {
            const cards = document.querySelectorAll('.c-card');
            const prevBtn = document.getElementById('cPrev');
            const nextBtn = document.getElementById('cNext');
            if(!cards.length) return;

            let currentIndex = 0;

            function updateCarousel() {
                cards.forEach((card, i) => {
                    card.classList.remove('active');
                    let offset = i - currentIndex;

                    if (offset < -Math.floor(cards.length / 2)) offset += cards.length;
                    if (offset > Math.floor(cards.length / 2)) offset -= cards.length;

                    if (offset === 0) {
                        card.style.transform = 'translateX(0) scale(1.15)';
                        card.style.zIndex = '5';
                        card.style.opacity = '1';
                        card.classList.add('active');
                    } else if (offset === 1) {
                        card.style.transform = 'translateX(180px) scale(0.9)';
                        card.style.zIndex = '4';
                        card.style.opacity = '0.8';
                    } else if (offset === -1) {
                        card.style.transform = 'translateX(-180px) scale(0.9)';
                        card.style.zIndex = '4';
                        card.style.opacity = '0.8';
                    } else if (offset === 2) {
                        card.style.transform = 'translateX(320px) scale(0.75)';
                        card.style.zIndex = '3';
                        card.style.opacity = '0.5';
                    } else if (offset === -2) {
                        card.style.transform = 'translateX(-320px) scale(0.75)';
                        card.style.zIndex = '3';
                        card.style.opacity = '0.5';
                    } else {
                        card.style.transform = offset > 0 ? 'translateX(450px) scale(0.6)' : 'translateX(-450px) scale(0.6)';
                        card.style.zIndex = '1';
                        card.style.opacity = '0';
                    }
                });
            }

            if(nextBtn) {
                nextBtn.addEventListener('click', () => {
                    currentIndex = (currentIndex + 1) % cards.length;
                    updateCarousel();
                });
            }

            if(prevBtn) {
                prevBtn.addEventListener('click', () => {
                    currentIndex = (currentIndex - 1 + cards.length) % cards.length;
                    updateCarousel();
                });
            }

            cards.forEach((card, i) => {
                card.addEventListener('click', () => {
                    currentIndex = i;
                    updateCarousel();
                });
            });

            updateCarousel();
        });
    </script>

</body>
</html>