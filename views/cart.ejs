<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Your Cart — Vastraa</title>
<link rel="stylesheet" href="/css/theme.css">
<script src="/js/theme.js"></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<style>
    body{background:#faf8f5;color:#241b20}
    .cart-page{max-width:1180px;margin:0 auto;padding:35px 18px 70px}
    .cart-top{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ddd2c8;padding-bottom:18px;margin-bottom:22px}
    .cart-top h1{font-size:28px;font-weight:500;color:#3e0f22;margin:0}
    .cart-top p{margin:5px 0 0;color:#786b72;font-size:13px}
    .cart-layout{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:25px}
    .cart-card,.summary-card{background:#fff;border:1px solid #e6ddd5;border-radius:12px}
    .cart-card{overflow:hidden}
    .cart-row{display:grid;grid-template-columns:100px 1fr auto;gap:18px;padding:18px;border-bottom:1px solid #eee7e1;align-items:center}
    .cart-row:last-child{border-bottom:0}
    .cart-img{width:100px;height:125px;background:#f4eee8;border-radius:7px;overflow:hidden}
    .cart-img img{width:100%;height:100%;object-fit:cover}
    .cart-info h3{font-size:15px;font-weight:600;margin:0 0 7px;color:#33272d}
    .cart-info .meta{font-size:12px;color:#897b82;margin-bottom:14px}
    .price{font-size:16px;font-weight:700;color:#3e0f22}
    .qty{display:inline-flex;align-items:center;border:1px solid #d9d0ca;border-radius:6px;margin-top:12px}
    .qty span{width:30px;height:28px;display:flex;align-items:center;justify-content:center;font-size:12px}
    .remove{border:0;background:none;color:#8a747d;font-size:12px;text-decoration:underline;cursor:pointer;margin-top:12px}
    .summary-card{padding:22px;position:sticky;top:20px}
    .summary-card h2{font-size:18px;font-weight:600;color:#3e0f22;margin:0 0 20px}
    .summary-row{display:flex;justify-content:space-between;gap:20px;margin:13px 0;font-size:13px;color:#5e5158}
    .summary-total{border-top:1px solid #e5ddd6;padding-top:16px;margin-top:18px;font-size:17px;font-weight:700;color:#2e2027}
    .free{color:#16804b;font-weight:600}
    .checkout-main{width:100%;border:0;background:#111;color:#fff;padding:15px;border-radius:6px;font-size:13px;font-weight:700;letter-spacing:1px;margin-top:18px;cursor:pointer}
    .checkout-main:disabled{opacity:.55;cursor:not-allowed}
    .continue{display:block;text-align:center;color:#5c1a33;text-decoration:none;font-size:12px;margin-top:15px}
    .secure-note{text-align:center;color:#8a7b82;font-size:11px;margin-top:18px;line-height:1.5}
    .empty{background:#fff;border:1px solid #e6ddd5;border-radius:12px;padding:70px 20px;text-align:center;color:#75666e}

    /* Checkout drawer/modal */
    .pay-overlay{position:fixed;inset:0;background:rgba(0,0,0,.58);z-index:99999;display:none}
    .pay-overlay.show{display:block}
    .pay-panel{position:absolute;right:0;top:0;height:100%;width:min(470px,100%);background:#fff;box-shadow:-12px 0 35px rgba(0,0,0,.25);display:flex;flex-direction:column}
    .pay-head{padding:18px 20px;border-bottom:1px solid #e7e0da;display:flex;align-items:center;gap:12px}
    .back-btn,.close-btn{border:0;background:none;cursor:pointer;font-size:21px;color:#3e0f22}
    .pay-brand{font-family:Georgia,serif;letter-spacing:5px;font-size:18px;color:#111;flex:1}
    .pay-head .count{font-size:11px;color:#7d7077}
    .pay-scroll{padding:14px 12px 30px;overflow:auto}
    .saving{background:#eef8f2;color:#21764c;border-radius:8px;padding:10px 12px;text-align:center;font-size:12px;margin-bottom:10px}
    .pay-total{display:flex;justify-content:space-between;align-items:center;padding:8px 4px 14px;font-size:13px}
    .pay-total strong{font-size:19px;color:#2d2027}
    .coupon{display:flex;border:1px solid #ddd3cb;border-radius:9px;overflow:hidden;margin-bottom:12px}
    .coupon input{flex:1;border:0;padding:12px;font-size:12px;outline:none}
    .coupon button{border:0;background:#f6f0ea;color:#5c1a33;padding:0 15px;font-weight:700;cursor:pointer}
    .method-title{font-size:12px;font-weight:700;color:#6e6068;margin:17px 3px 8px;text-transform:uppercase;letter-spacing:1px}
    .method{width:100%;display:flex;align-items:center;gap:12px;border:1px solid #e0d7d0;background:#fff;border-radius:9px;padding:14px 13px;margin:7px 0;cursor:pointer;text-align:left;transition:.18s}
    .method:hover{border-color:#b89a77;box-shadow:0 2px 9px rgba(70,35,20,.07)}
    .method .icon{width:30px;height:30px;border-radius:7px;background:#f5eee7;display:flex;align-items:center;justify-content:center;font-size:15px}
    .method .mtxt{flex:1}
    .method .mtxt strong{display:block;font-size:13px;color:#352a30}
    .method .mtxt small{display:block;color:#91838a;font-size:10px;margin-top:3px}
    .method .amt{font-size:12px;font-weight:700;color:#34262d}
    .method .arrow{font-size:18px;color:#766870}
    .cod{border-color:#d8e9df}
    .login-strip{margin-top:15px;border:1px solid #e0d7d0;border-radius:9px;padding:12px;font-size:11px;color:#6d6067;display:flex;justify-content:space-between}
    .pay-foot{margin-top:auto;border-top:1px solid #e5ddd6;padding:12px 16px;background:#fff;font-size:10px;color:#8a7b82;text-align:center}
    .error{display:none;background:#fff0ef;color:#a52b20;border:1px solid #efc6c1;border-radius:8px;padding:10px;font-size:12px;margin-bottom:10px}
    @media(max-width:760px){
        .cart-layout{grid-template-columns:1fr}
        .summary-card{position:static}
        .cart-row{grid-template-columns:78px 1fr auto;gap:12px}
        .cart-img{width:78px;height:105px}
    }
</style>
</head>

<body>
<%- include('partials/navbar') %>

<div class="cart-page">
    <div class="cart-top">
        <div>
            <h1>Your Cart</h1>
            <p><%= products.length %> item<%= products.length !== 1 ? 's' : '' %> in your cart</p>
        </div>
        <a href="/product/home" class="continue">Continue Shopping</a>
    </div>

    <% if(products.length > 0){ %>
        <% var cartTotal = products.reduce(function(sum,p){return sum+((p.price||0)*Number(p.quantity||1))},0); %>

        <div class="cart-layout">
            <div class="cart-card">
                <% products.forEach(function(product){ %>
                    <div class="cart-row">
                        <div class="cart-img">
                            <img src="/images/<%= product.image %>" alt="<%= product.title %>"
                                 onerror="imgFallback(this,'<%= product.title.replace(/'/g,'') %>')">
                        </div>
                        <div class="cart-info">
                            <h3><%= product.title %></h3>
                            <div class="meta">Premium Handcrafted • Ready to ship</div>
                            <% if(product.size){ %><div class="meta" style="margin-top:5px;"><strong>Size:</strong> <%= product.size %></div><% } %>
                            <div class="price">₹<%= (product.price || 0).toLocaleString('en-IN') %></div>
                            <div class="qty"><span>Qty</span><span><%= product.quantity || 1 %></span></div>
                        </div>
                        <form action="/product/cart/delete/<%= product._id %>" method="POST">
                            <button class="remove" type="submit">Remove</button>
                        </form>
                    </div>
                <% }) %>
            </div>

            <aside class="summary-card">
                <h2>Order Summary</h2>
                <div class="summary-row"><span>Subtotal</span><span>₹<%= cartTotal.toLocaleString('en-IN') %></span></div>
                <div class="summary-row"><span>Shipping</span><span class="free">FREE</span></div>
                <div class="summary-row"><span>Taxes</span><span>Included</span></div>
                <div class="summary-row summary-total"><span>Total</span><span>₹<%= cartTotal.toLocaleString('en-IN') %></span></div>
                <button class="checkout-main" id="checkoutBtn">CHECKOUT</button>
                <div class="secure-note">Secure checkout • UPI • Cards • Netbanking • Wallets<br>Cash on Delivery available</div>
            </aside>
        </div>
    <% } else { %>
        <div class="empty">
            <div style="font-size:42px;margin-bottom:15px">🛒</div>
            Your cart is empty.
            <div style="margin-top:22px"><a href="/product/home" class="checkout-main" style="display:inline-block;width:auto;text-decoration:none">START SHOPPING</a></div>
        </div>
    <% } %>
</div>

<!-- Checkout drawer -->
<div class="pay-overlay" id="payOverlay">
    <div class="pay-panel">
        <div class="pay-head">
            <button class="back-btn" id="closePay" aria-label="Close">‹</button>
            <div class="pay-brand">VASTRAA</div>
            <div class="count"><%= products.length %> items</div>
            <button class="close-btn" id="closePayX" aria-label="Close">×</button>
        </div>

        <div class="pay-scroll">
            <div class="saving">✓ Secure checkout with encrypted payment</div>
            <div class="pay-total"><span>Payable amount</span><strong id="payAmount">₹0</strong></div>

            <div class="coupon">
                <input id="couponInput" placeholder="Enter coupon code">
                <button type="button" id="couponBtn">APPLY</button>
            </div>

            <div class="error" id="payError"></div>

            <div class="method-title">Choose payment method</div>

            <button class="method" data-method="online">
                <div class="icon">↗</div>
                <div class="mtxt"><strong>UPI / QR / Cards</strong><small>Pay securely with Razorpay</small></div>
                <div class="amt" id="onlineAmt">₹0</div><div class="arrow">›</div>
            </button>

            <button class="method" data-method="netbanking">
                <div class="icon">▣</div>
                <div class="mtxt"><strong>Netbanking</strong><small>All major banks supported</small></div>
                <div class="amt">₹<%= products.reduce(function(s,p){return s+(p.price||0)},0).toLocaleString('en-IN') %></div><div class="arrow">›</div>
            </button>

            <button class="method" data-method="wallet">
                <div class="icon">▤</div>
                <div class="mtxt"><strong>Wallets</strong><small>Choose a wallet in Razorpay</small></div>
                <div class="amt">₹<%= products.reduce(function(s,p){return s+(p.price||0)},0).toLocaleString('en-IN') %></div><div class="arrow">›</div>
            </button>

            <button class="method" data-method="emi">
                <div class="icon">◫</div>
                <div class="mtxt"><strong>EMI</strong><small>Available options shown by gateway</small></div>
                <div class="amt">₹<%= products.reduce(function(s,p){return s+(p.price||0)},0).toLocaleString('en-IN') %></div><div class="arrow">›</div>
            </button>

            <button class="method cod" data-method="cod">
                <div class="icon">₹</div>
                <div class="mtxt"><strong>Cash on Delivery</strong><small>Pay when your order arrives</small></div>
                <div class="amt">₹<%= products.reduce(function(s,p){return s+(p.price||0)},0).toLocaleString('en-IN') %></div><div class="arrow">›</div>
            </button>

            <div class="login-strip">
                <span>✓ Logged in as <%= user && user.email ? user.email : 'customer' %></span>
                <a href="/user/logout" style="color:#5c1a33">Logout</a>
            </div>
        </div>

        <div class="pay-foot">By proceeding, you agree to the store's Terms & Privacy Policy.</div>
    </div>
</div>

<%- include('partials/footer') %>
<%- include('partials/whatsapp-widget') %>
<%- include('partials/login-toast') %>

<script>
(function(){
    const checkoutBtn = document.getElementById("checkoutBtn");
    const overlay = document.getElementById("payOverlay");
    const closePay = document.getElementById("closePay");
    const closePayX = document.getElementById("closePayX");
    const payAmount = document.getElementById("payAmount");
    const onlineAmt = document.getElementById("onlineAmt");
    const payError = document.getElementById("payError");
    const couponBtn = document.getElementById("couponBtn");

    let cartTotal = 0;

    function money(n){ return "₹" + Number(n).toLocaleString("en-IN"); }

    function showError(msg){
        payError.textContent = msg || "Something went wrong.";
        payError.style.display = "block";
    }

    function hideError(){ payError.style.display = "none"; }

    async function loadTotal(){
        const r = await fetch("/product/cart/total");
        const d = await r.json();
        if(!d.success || !d.itemCount) throw new Error("Your cart is empty.");
        cartTotal = Number(d.total || 0);
        payAmount.textContent = money(cartTotal);
        onlineAmt.textContent = money(cartTotal);
    }

    async function openCheckout(){
        hideError();
        checkoutBtn.disabled = true;
        checkoutBtn.textContent = "LOADING...";
        try{
            await loadTotal();
            overlay.classList.add("show");
            document.body.style.overflow = "hidden";
        }catch(e){
            showError(e.message);
        }finally{
            checkoutBtn.disabled = false;
            checkoutBtn.textContent = "CHECKOUT";
        }
    }

    function closeCheckout(){
        overlay.classList.remove("show");
        document.body.style.overflow = "";
    }

    async function startRazorpay(){
        hideError();
        try{
            const r = await fetch("/product/checkout/create-order", {
                method:"POST",
                headers:{"Content-Type":"application/json"}
            });
            const d = await r.json();
            if(!r.ok || !d.success) throw new Error(d.message || "Could not start payment.");

            const options = {
                key: d.key,
                amount: d.amount,
                currency: d.currency || "INR",
                name: "Vastraa",
                description: "Order payment",
                order_id: d.orderId,
                prefill: {
                    name: d.name || "",
                    email: d.email || ""
                },
                theme: {color:"#5c1a33"},
                handler: async function(response){
                    try{
                        const vr = await fetch("/product/checkout/verify", {
                            method:"POST",
                            headers:{"Content-Type":"application/json"},
                            body: JSON.stringify(response)
                        });
                        const vd = await vr.json();
                        if(!vr.ok || !vd.success) throw new Error(vd.message || "Payment verification failed.");
                        window.location.href = vd.redirect;
                    }catch(e){
                        showError(e.message);
                    }
                },
                modal: {
                    ondismiss: function(){ }
                }
            };

            const rzp = new Razorpay(options);
            rzp.on("payment.failed", function(response){
                showError((response.error && response.error.description) || "Payment failed. Please try again.");
            });
            rzp.open();
        }catch(e){
            showError(e.message);
        }
    }

    async function placeCOD(){
        hideError();
        try{
            const r = await fetch("/product/checkout/cod", {method:"POST"});
            const d = await r.json();
            if(!r.ok || !d.success) throw new Error(d.message || "Could not place COD order.");
            window.location.href = d.redirect;
        }catch(e){
            showError(e.message);
        }
    }

    if(checkoutBtn) checkoutBtn.addEventListener("click", openCheckout);
    closePay.addEventListener("click", closeCheckout);
    closePayX.addEventListener("click", closeCheckout);
    overlay.addEventListener("click", e => { if(e.target === overlay) closeCheckout(); });

    document.querySelectorAll(".method").forEach(btn => {
        btn.addEventListener("click", function(){
            const method = this.dataset.method;
            if(method === "cod") placeCOD();
            else startRazorpay();
        });
    });

    couponBtn.addEventListener("click", function(){
        const code = document.getElementById("couponInput").value.trim();
        if(!code) return showError("Enter a coupon code.");
        showError("Coupon system is not configured yet.");
    });
})();
</script>
</body>
</html>
