<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title><%= shopName %> AI Assistant</title>
<style>
*{box-sizing:border-box}body{margin:0;background:linear-gradient(135deg,#1d0b15,#5b1b3a);font-family:Arial,sans-serif;min-height:100vh}.chat{width:min(760px,94%);margin:35px auto;background:#fff;border-radius:22px;overflow:hidden;box-shadow:0 25px 70px #0006}.head{padding:22px;background:#3b1026;color:#fff}.head h1{margin:0}.head p{margin:6px 0 0;color:#ddc7d2;font-size:13px}.messages{height:58vh;overflow:auto;padding:20px;background:#faf7f8}.msg{max-width:80%;padding:12px 15px;border-radius:15px;margin:9px 0;white-space:pre-wrap;line-height:1.5;font-size:14px}.bot{background:#eee5ea;color:#33242c}.me{background:#6b2043;color:#fff;margin-left:auto}.form{display:flex;gap:10px;padding:14px;border-top:1px solid #eee}.form input{flex:1;padding:13px;border:1px solid #ddd;border-radius:12px}.form button{border:0;background:#6b2043;color:#fff;border-radius:12px;padding:0 20px}.back{display:block;text-align:center;padding-bottom:15px;color:#6b2043;text-decoration:none;font-size:13px}
</style></head><body><div class="chat"><div class="head"><h1>✨ <%= shopName %> AI Assistant</h1><p>Ask about products, prices, categories or what may suit your budget.</p></div><div class="messages" id="messages"><div class="msg bot">Hi! Ask me something like: “₹2000 ke under products dikhao” or “pink kurta ka price kya hai?”</div></div><form class="form" id="chatForm"><input id="message" placeholder="Type your question..." autocomplete="off" required><button>Send</button></form><a class="back" href="/product/home">← Back to store</a></div>
<script>
const form=document.getElementById("chatForm"), input=document.getElementById("message"), messages=document.getElementById("messages");
function add(text, cls){const d=document.createElement("div");d.className="msg "+cls;d.textContent=text;messages.appendChild(d);messages.scrollTop=messages.scrollHeight;}
form.addEventListener("submit",async e=>{e.preventDefault();const q=input.value.trim();if(!q)return;add(q,"me");input.value="";add("Thinking…","bot");const thinking=messages.lastChild;try{const r=await fetch("/ai/chat",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({message:q})});const data=await r.json();thinking.remove();add(data.answer||data.error||"Sorry, something went wrong.","bot")}catch(err){thinking.remove();add("AI service is unavailable right now.","bot")}});
</script></body></html>
