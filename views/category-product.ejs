<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= categoryName %> — Vastraa</title>

<link rel="stylesheet" href="/css/theme.css">
<script src="/js/theme.js"></script>

<style>

    .cat-hero{
        background: linear-gradient(135deg, var(--wine-deep) 0%, var(--wine) 100%);
        padding: 56px 20px 46px;
        text-align: center;
        color: #fff;
    }

    .cat-hero .eyebrow{
        font-size: 12px;
        letter-spacing: 4px;
        text-transform: uppercase;
        color: var(--gold);
    }

    .cat-hero h1{
        font-size: 44px;
        font-weight: 500;
        margin-top: 10px;
        color: #fff;
    }

    .cat-hero p{
        margin-top: 12px;
        font-size: 14px;
        color: #f0dfe6;
        max-width: 520px;
        margin-left: auto;
        margin-right: auto;
    }

    .cat-hero .breadcrumb{
        margin-top: 18px;
        font-size: 12px;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #e3c9d1;
    }

    .cat-hero .breadcrumb a{ color: var(--gold); text-decoration: none; }

    .cat-count{
        width: 92%;
        max-width: 1400px;
        margin: 34px auto 0;
        font-size: 13px;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #8a7a86;
    }

    @media(max-width: 640px){
        .cat-hero h1{ font-size: 30px; }
    }

</style>

</head>

<body>

    <%- include('partials/navbar') %>

    <!-- PAGE HEADER -->

    <div class="cat-hero">

        <span class="eyebrow">Curated Collection</span>

        <h1><%= categoryName %></h1>

        <p>Explore premium <%= categoryName.toLowerCase() %> pieces, handpicked for modern elegance.</p>

        <div class="breadcrumb">
            <a href="/product/home">Home</a> &nbsp;/&nbsp; <%= categoryName %>
        </div>

    </div>

    <% if(products.length > 0){ %>
        <div class="cat-count"><%= products.length %> product<%= products.length !== 1 ? 's' : '' %> in <%= categoryName %></div>
    <% } %>

    <!-- PRODUCTS -->

    <div class="section" style="margin-top: 20px;">

        <% if(products.length > 0){ %>

            <div class="product-grid">

                <% products.forEach(function(product, i){ %>

                    <div class="p-card">

                        <% if(i < 2){ %>
                            <span class="tag">New</span>
                        <% } %>

                        <a href="/product/view/<%= product._id %>" class="p-img">
                            <img src="/images/<%= product.image %>" alt="<%= product.title %>"
                                onerror="imgFallback(this, '<%= product.title.replace(/'/g, '') %>')">
                        </a>

                        <div class="p-body">

                            <a href="/product/view/<%= product._id %>" style="text-decoration:none; color:inherit;">
                                <h4><%= product.title %></h4>
                            </a>
                            <div class="p-meta">Premium Handcrafted</div>
                            <% if(product.price){ %>
                                <div class="p-price">₹<%= product.price.toLocaleString('en-IN') %></div>
                            <% } %>

                            <form action="/product/cart/add/<%= product._id %>" method="POST">
                                <button type="submit" class="cart-btn">Add To Cart</button>
                            </form>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } else { %>

            <div class="empty-state">
                <div class="e-icon">😔</div>
                No products found in this collection yet.
            </div>

        <% } %>

    </div>

    <!-- TRUST STRIP -->

    <div class="trust-strip">

        <div class="trust-item">
            <span class="t-icon">🚚</span>
            <div>
                <h5>Free Shipping</h5>
                <p>On all prepaid orders above ₹2999</p>
            </div>
        </div>

        <div class="trust-item">
            <span class="t-icon">↩️</span>
            <div>
                <h5>Easy Returns</h5>
                <p>7-day hassle free return policy</p>
            </div>
        </div>

        <div class="trust-item">
            <span class="t-icon">🔒</span>
            <div>
                <h5>Secure Payments</h5>
                <p>100% safe & encrypted checkout</p>
            </div>
        </div>

        <div class="trust-item">
            <span class="t-icon">🧵</span>
            <div>
                <h5>Certified Artisans</h5>
                <p>Supporting genuine handloom craft</p>
            </div>
        </div>

    </div>

    <%- include('partials/footer') %>

    <%- include('partials/login-toast') %>

</body>
</html>
