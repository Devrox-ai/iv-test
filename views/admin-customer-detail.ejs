<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Customer — <%= shopName %></title>
<style>
body{margin:0;background:#faf7f4;color:#30252b;font:13px Arial}.top{background:#fff;border-bottom:1px solid #e8ddd6;padding:14px 4%;display:flex;justify-content:space-between}.top a{color:#5b1635;text-decoration:none;font-size:11px}.wrap{width:min(1100px,94%);margin:25px auto}.head,.stats,.order{background:#fff;border:1px solid #e8ddd6;border-radius:13px}.head{padding:18px}.head h1{font:500 27px Georgia;color:#351020;margin:0}.head p{color:#887982;font-size:11px;line-height:1.6}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin:14px 0;overflow:hidden}.stat{padding:15px;border-right:1px solid #eee6e1}.stat:last-child{border:0}.stat small{display:block;color:#887982;font-size:9px}.stat b{display:block;color:#351020;font-size:19px;margin-top:5px}.order{padding:14px;margin-bottom:10px;display:flex;justify-content:space-between;gap:15px;align-items:center}.order b{color:#351020}.order small{display:block;color:#887982;margin-top:5px}.money{color:#5b1635;font-weight:800}.pill{padding:5px 8px;background:#fff5e4;color:#b56b17;border-radius:20px;font-size:8px;font-weight:800}.empty{background:#fff;border:1px solid #e8ddd6;padding:40px;text-align:center;color:#887982;border-radius:13px}@media(max-width:600px){.stats{grid-template-columns:1fr}.stat{border-right:0;border-bottom:1px solid #eee6e1}.order{align-items:flex-start;flex-direction:column}}
</style></head><body><header class="top"><a href="/admin/dashboard">← Dashboard</a><a href="/admin/logout">Logout</a></header><main class="wrap">
<section class="head"><h1><%= user.name||'Customer' %></h1><p>📱 <%= user.phone||'No phone' %><br>✉️ <%= user.email||'No email' %></p></section>
<section class="stats"><div class="stat"><small>Total Orders</small><b><%= orders.length %></b></div><div class="stat"><small>Total Spent</small><b>₹<%= Number(totalSpent).toLocaleString('en-IN') %></b></div><div class="stat"><small>Last Order</small><b style="font-size:12px"><%= orders[0]?.createdAt?new Date(orders[0].createdAt).toLocaleDateString('en-IN'):'—' %></b></div></section>
<h2 style="font:500 20px Georgia;color:#351020">Order History</h2>
<% if(orders.length){ orders.forEach(function(o){ %><a href="/admin/orders/<%= o._id %>" style="text-decoration:none;color:inherit"><div class="order"><div><b>#<%= o._id %></b><small><%= o.createdAt?new Date(o.createdAt).toLocaleString('en-IN'):'' %> · <%= o.items?.length||0 %> item(s)</small></div><div style="text-align:right"><div class="money">₹<%= Number(o.total||0).toLocaleString('en-IN') %></div><span class="pill"><%= o.status||'unknown' %></span></div></div></a><% }) } else { %><div class="empty">No orders for this customer.</div><% } %>
</main></body></html>